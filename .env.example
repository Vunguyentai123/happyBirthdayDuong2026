# Hũ điều ước → Firebase Realtime Database
# Copy file này thành `.env.local` rồi điền URL thật. `.env.local` không commit.
#
# Lấy URL ở Firebase Console → Realtime Database → khung data URL đầu trang
# (dạng https://<project>-default-rtdb.asia-southeast1.firebasedatabase.app).
# Không cần API key hay database secret: client chỉ ghi, rules chặn đọc.
VITE_FIREBASE_DB_URL=

# Nhánh lưu điều ước. Để trống cũng được, mặc định là `wishes`.
VITE_FIREBASE_WISH_PATH=wishes
